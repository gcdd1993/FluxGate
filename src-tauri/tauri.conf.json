{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxGate",
  "version": "0.0.2",
  "identifier": "dev.fluxgate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FluxGate · Local AI Gateway",
      "width": 1440,
      "height": 920,
      "minWidth": 960,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "decorations": true,
      "backgroundColor": "#0b0e14",
      "dragDropEnabled": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/gcdd1993/FluxGate/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyN0NGOTE1RTY1MUE2NgpSV1JtR21WZWtjOG5EUXppMWRVR0g0Mnpta0dmOXJnT3dSS0NKMXQ5MDVnNkJZVGd2YzQxRHprVQo="
    }
  }
}

