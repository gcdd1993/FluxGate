{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FluxGate",
  "version": "0.1.0",
  "identifier": "dev.fluxgate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "FluxGate · Local AI Gateway",
      "width": 1440,
      "height": 920,
      "minWidth": 960,
      "minHeight": 680,
      "resizable": true,
      "fullscreen": false,
      "center": true,
      "decorations": true,
      "backgroundColor": "#0b0e14"
    }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}

